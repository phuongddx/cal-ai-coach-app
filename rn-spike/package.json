{
  "name": "coachcal-rn-spike",
  "private": true,
  "version": "0.0.0",
  "description": "Throwaway React Native + Expo spike for CoachCal (branch spike/rn-expo). Not production code.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api": "npm run dev --workspace @coachcal/api",
    "mobile": "npm run start --workspace @coachcal/mobile"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.16",
    "test-renderer": "^1.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  }
}
