{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "runtimeVersion": { "policy": "fingerprint" },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "runtimeVersion": { "policy": "fingerprint" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "runtimeVersion": { "policy": "fingerprint" },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
