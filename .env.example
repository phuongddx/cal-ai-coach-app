# CoachCal scan pipeline — environment names and placeholders ONLY. Never commit real values.
# Local: supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set NAME=value
# No SUPABASE_-prefixed custom names — that prefix is reserved by the platform.

# VLM provider seam (owner: analyze-food). fixture is the Phase 2/3 default;
# the live flip is Phase 4 and stays config-only.
VLM_PROVIDER=fixture
VLM_FIXTURE_MODE=normal
VLM_FIXTURE_LATENCY_MS=600

# AI + food-data providers (owner: grounding cascade / live VLM).
GEMINI_API_KEY=
# DEMO_KEY works for local smoke; register a personal key at fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
OFF_USER_AGENT=CoachCal/0.1
# Phase 4 — the FatSecret adapter returns typed NOT_FOUND until these exist.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# RevenueCat webhook signing (owner: rc-webhook). Live RevenueCat is Phase 5;
# function tests self-sign locally and the smoke script writes a local value
# to supabase/functions/.env.
RC_WEBHOOK_SIGNING_SECRET=
