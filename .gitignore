# Signing material — never commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# macOS
.DS_Store
*.orig.*

# Generated native SwiftUI project (Tuist output)
/native/*.xcodeproj
/native/DerivedData/
/native/artifacts/

# GSD planning docs (commit_docs=false — local only)
.planning/

# Local env files with real credentials
.env
.env.*
# Secrets manifest template — names and placeholders only
!.env.example

# SwiftPM isolated scratch builds (swift test --scratch-path .build-XXXX)
.build-*/

# Local git worktrees (superpowers:using-git-worktrees)
.worktrees/

# Node / Expo monorepo (apps/, packages/)
node_modules/
.expo/
dist/
expo-env.d.ts
*.tsbuildinfo
# generated native folders (Continuous Native Generation)
apps/*/ios/
apps/*/android/
apps/*/.kotlin/
coverage/
# machine-generated evidence that is large; curated screenshots under docs/ are committed
docs/rn-migration/evidence/tmp/
*.log
# locally built app bundles kept for `xcrun simctl install`; never committed
apps/mobile/build-output/
