<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as CoachCal.entitlements — the ONLY channel through which
	     this widget process reads the host app's calories-remaining/ED-Safe snapshot. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nextlabs.coachcal</string>
	</array>
</dict>
</plist>
