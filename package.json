{
  "name": "coachcal",
  "private": true,
  "version": "1.0.0",
  "description": "CoachCal monorepo: React Native + Expo app (apps/mobile), Hono API (apps/api), shared packages (packages/core, packages/api-contract).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typed-routes": "node scripts/rn/gen-typed-routes.mjs",
    "typecheck": "npm run typed-routes && npm run typecheck --workspaces --if-present",
    "api": "npm run dev --workspace @coachcal/api",
    "mobile": "npm run start --workspace @coachcal/mobile",
    "test:api": "npm run test --workspace @coachcal/api",
    "test:mobile": "npm run test --workspace @coachcal/mobile",
    "parity:check": "node scripts/rn/parity-check.mjs",
    "parity:write": "node scripts/rn/parity-check.mjs --write"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.16",
    "test-renderer": "^1.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
