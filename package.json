{
  "name": "coachcal",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "\\.sql$": "<rootDir>/scripts/jest/sql-transform.cjs"
    },
    "moduleNameMapper": {
      "^\\./ExpoSQLite$": "<rootDir>/node_modules/expo-sqlite/build/ExpoSQLite.web.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)",
      "**/?(*.)+(test).ts?(x)"
    ]
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^15.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@sentry/react-native": "^8.26.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^4.71.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "drizzle-kit": "^0.30.4",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  }
}
