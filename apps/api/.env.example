# CoachCal API environment. Names only: set real values in your own untracked .env, never here.

# Postgres connection string for the API role (coachcal_api: EXECUTE on the SQL functions, no table privileges).
DATABASE_URL=
# TCP port the API listens on.
PORT=
# Set to 1 to accept the checked-in dev tokens (apps/api/dev-tokens.json); anything else makes protected routes answer 401.
AUTH_DEV_TOKENS=

# Which VLM backend analyses photo, label and text scans (gemini or fixture).
VLM_PROVIDER=
# Google Gemini API key used by the gemini VLM provider (server-side only).
GEMINI_API_KEY=
# Gemini model for the Tier-1 pass of a scan.
GEMINI_MODEL=
# Gemini model for the Tier-2 escalation pass (low scan or item confidence).
GEMINI_ESCALATION_MODEL=
# Fixture VLM failure mode for tests (malformed makes the fixture return schema-invalid output).
VLM_FIXTURE_MODE=
# Artificial latency in milliseconds for each fixture VLM call.
VLM_FIXTURE_LATENCY_MS=

# USDA FoodData Central API key for the FDC grounding tier (barcode and search).
USDA_FDC_API_KEY=
# FatSecret OAuth client id for the FatSecret barcode tier.
FATSECRET_CLIENT_ID=
# FatSecret OAuth client secret for the FatSecret barcode tier.
FATSECRET_CLIENT_SECRET=
# User-Agent string sent to Open Food Facts (it asks clients to identify themselves).
OFF_USER_AGENT=
