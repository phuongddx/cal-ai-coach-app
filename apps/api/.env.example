# CoachCal API environment. Names and meanings only: put real values in your own untracked file
# (apps/api/deploy/.env on the VPS, or the shell for a local run). Never commit real values.
# "required" = the API refuses to start without it. Secrets: generate with `openssl rand -hex 32`.

# ---- API process ----------------------------------------------------------------------------
# Postgres connection string for the API role coachcal_api (EXECUTE on the SQL functions, no table privileges). Required (compose builds it).
DATABASE_URL=
# Public HTTPS address of the API, no trailing slash, for instance https://api.example.com. Needed for Google sign-in (callback URL) and Secure cookies. Required in compose.
PUBLIC_BASE_URL=
# TCP port the API listens on (default 8787).
PORT=
# Address the API binds to (default 127.0.0.1; compose sets 0.0.0.0 inside the container).
HOST=
# Set to 1 to run apps/api/migrations at start (needs OWNER_DATABASE_URL). Compose uses the one-shot migrate service instead.
RUN_MIGRATIONS_ON_START=
# Postgres connection string for the owner role coachcal_owner; only read when RUN_MIGRATIONS_ON_START=1 and by `npm run migrate` (as DATABASE_URL).
OWNER_DATABASE_URL=
# Set to 1 to accept the checked-in dev tokens in apps/api/dev-tokens.json. Local and tests only: never in production.
AUTH_DEV_TOKENS=
# Path of the dev-token file (default apps/api/dev-tokens.json).
DEV_TOKENS_FILE=
# Directory of the SQL migrations (default ./migrations next to the API).
MIGRATIONS_DIR=

# ---- Secrets generated once (required) ------------------------------------------------------
# Signs the 15-minute access tokens (HS256). At least 32 characters. Changing it signs every user out.
AUTH_JWT_SECRET=
# Root key for encrypting stored secrets (Apple refresh tokens) and keying e-mail codes and the Google state. At least 32 characters. Losing or changing it makes stored Apple tokens unreadable and invalidates pending codes.
AUTH_ENCRYPTION_KEY=
# Shared secret that RevenueCat signs its webhook with (HMAC-SHA256); the same value goes into the RevenueCat dashboard.
RC_WEBHOOK_SIGNING_SECRET=

# ---- E-mail sign-in code --------------------------------------------------------------------
# How the six-digit code is delivered: resend (mail through Resend) or log (prints it to the API log; local only). Required.
OTP_SENDER=
# Resend API key; required when OTP_SENDER=resend.
RESEND_API_KEY=
# From address of the code e-mail on a domain verified in Resend, for instance "CoachCal <login@example.com>"; required when OTP_SENDER=resend.
OTP_FROM=

# ---- Sign in with Apple (optional; the route answers 503 until all four are set) ------------
# The app's bundle id (App ID); the identity token's audience.
APPLE_BUNDLE_ID=
# Apple Developer Team ID (10 characters).
APPLE_TEAM_ID=
# Key ID of the Sign in with Apple private key (.p8).
APPLE_KEY_ID=
# Path of the .p8 file inside the container; compose mounts apps/api/deploy/secrets at /run/secrets, so /run/secrets/AuthKey_XXXX.p8.
APPLE_PRIVATE_KEY_PATH=

# ---- Sign in with Google (optional; the routes answer 503 until these and PUBLIC_BASE_URL are set) ----
# OAuth 2.0 client id (type Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Client secret of that OAuth client.
GOOGLE_CLIENT_SECRET=

# ---- Scan pipeline --------------------------------------------------------------------------
# Which VLM backend analyses photo, label and text scans: gemini or fixture (fixture = canned answers, local and tests).
VLM_PROVIDER=
# Google Gemini API key used by the gemini provider (server side only).
GEMINI_API_KEY=
# Gemini model for the first pass of a scan (a built-in default applies when empty).
GEMINI_MODEL=
# Gemini model for the second pass when scan or item confidence is low (a built-in default applies when empty).
GEMINI_ESCALATION_MODEL=
# Fixture VLM failure mode for tests (malformed makes the fixture return schema-invalid output).
VLM_FIXTURE_MODE=
# Artificial latency in milliseconds for each fixture VLM call.
VLM_FIXTURE_LATENCY_MS=
# USDA FoodData Central API key for the grounding tier (barcode and search).
USDA_FDC_API_KEY=
# FatSecret OAuth client id for the FatSecret barcode tier (optional).
FATSECRET_CLIENT_ID=
# FatSecret OAuth client secret for the FatSecret barcode tier (optional).
FATSECRET_CLIENT_SECRET=
# User-Agent sent to Open Food Facts (it asks clients to identify themselves).
OFF_USER_AGENT=

# ---- VPS compose stack only (apps/api/deploy/docker-compose.yml, backup.sh) ------------------
# Public host name Caddy gets a certificate for, for instance api.example.com (localhost works for a local try-out). Required.
DOMAIN=
# Superuser name of the PostgreSQL container (default postgres).
POSTGRES_USER=
# Password of that superuser; used by backup.sh and by the first-start role setup. Required.
POSTGRES_PASSWORD=
# Password of the coachcal_owner role (owns the tables, runs migrations). Use letters and digits only (it goes into a URL). Required.
COACHCAL_OWNER_PASSWORD=
# Password of the coachcal_api role (what the API connects as). Letters and digits only. Required.
COACHCAL_API_PASSWORD=
# Host ports Caddy publishes (default 80 and 443); change only for a local try-out.
HTTP_PORT=
HTTPS_PORT=
# Compose project name (default coachcal); also prefixes the volume names.
COMPOSE_PROJECT_NAME=
# Where backup.sh writes dumps (default apps/api/deploy/backups) and how many days it keeps them (default 14).
BACKUP_DIR=
BACKUP_KEEP_DAYS=
