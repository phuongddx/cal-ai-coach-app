{
  "name": "@coachcal/api",
  "version": "0.0.0",
  "private": true,
  "description": "CoachCal API (Node + Hono + PostgreSQL 17): scan, lookup, sync, account, auth, webhooks. Replaces the Supabase edge functions.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coachcal/api-contract": "*",
    "@coachcal/core": "*",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15"
  }
}
